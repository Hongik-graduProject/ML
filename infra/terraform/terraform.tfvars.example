# terraform.tfvars.example
# 이 파일을 복사하여 terraform.tfvars 로 저장한 뒤 실제 값을 채우세요.
# terraform.tfvars 는 .gitignore 에 등록되어 있습니다.

# GCP 프로젝트 ID (필수)
project_id = "your-gcp-project-id"

# 리전 / 존 (기본값: 서울)
region = "asia-northeast3"
zone   = "asia-northeast3-a"

# GCE VM 머신 타입
# - CPU only 테스트:  "e2-standard-4"
# - GPU 포함 운영:    "n1-standard-4"
machine_type = "e2-standard-4"

# GPU 설정
# gpu_enabled = true 로 설정하면 guest_accelerator 블록이 추가됩니다.
gpu_enabled = false
gpu_type    = "nvidia-tesla-t4"
gpu_count   = 1

# Cloud SQL 티어
# - 개발: "db-f1-micro"
# - 운영: "db-custom-2-7680"
db_tier = "db-f1-micro"

# SSH 허용 소스 IP 범위 (보안 강화 시 자신의 IP로 제한 권장)
# 예: ssh_source_ranges = ["203.0.113.0/24"]
ssh_source_ranges = ["0.0.0.0/0"]
