          "target_clip",
          "latest_prediction_date",
          "latest_prediction_count",
          "notes"
        ],
        "title": "ModelInfo"
      },
      "PredictionPage": {
        "properties": {
          "as_of_date": {
            "type": "string",
            "format": "date",
            "title": "As Of Date"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
