          },
          "avg_trading_value_20": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Trading Value 20"
          },
          "feature_coverage": {
            "type": "number",
            "title": "Feature Coverage"
          },
          "disclosure_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disclosure Date"
          },
          "financial_age_days": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Financial Age Days"
          },
          "financial_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Financial Source"
          },
          "macro_as_of_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Macro As Of Date"
          },
          "dna_age_days": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dna Age Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "code",
          "name",
          "sector",
          "close",
          "predicted_excess_return_60d",
          "predicted_percentile",
          "signal",
          "model_agreement_score",
          "model_disagreement",
          "scenario_price_if_kospi_flat",
          "avg_trading_value_20",
          "feature_coverage",
          "disclosure_date",
          "financial_age_days",
          "financial_source",
          "macro_as_of_date",
          "dna_age_days"
        ],
        "title": "LatestPredictionItem"
      },
      "ModelInfo": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "bundle_metadata_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bundle Metadata Version"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "target_definition": {
            "type": "string",
            "title": "Target Definition"
          },
          "feature_count": {
            "type": "integer",
            "title": "Feature Count"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Features"
          },
          "ensemble_xgb_weight": {
            "type": "number",
            "title": "Ensemble Xgb Weight"
          },
          "target_clip": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Target Clip"
          },
          "latest_prediction_date": {
            "type": "string",
            "format": "date",
